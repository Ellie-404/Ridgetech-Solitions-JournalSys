<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JournalSys</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JournalSys.styles.css" asp-append-version="true" />
    <link id="rolleCss" rel="stylesheet" href="~/css/secretary.css">
</head>
<body>

    <header id="header">  
        <div id="headerContainer">
            <nav class="navbar navbar-expand-sm">
                <div class="container">
                    <a class="navbar-brand" asp-page="/Index">HelseJournal</a>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark " asp-page="/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"  asp-page="/Receptionist/MainPageReceptionist">StarsideSekretær</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Lege/MainPageDR">StarsideLege</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/MainPageAdmin">StarsideAdmin</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <div id="mainContent" class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - JournalSys - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
